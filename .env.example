# IBM Bob Conversational & Task API
IBM_BOB_API_KEY=
# IBM_BOB_BASE_URL=https://api.us-east.bob.ibm.com/inference/v1

# Alternative LLM Gateway
ZENMUX_API_KEY=

# TypeSafe Decision Engine
JEV_API_KEY=

# Sarvam Voice (STT & TTS)
SARVAM_API_KEY=

# RapidAPI JSearch
X_RAPIDAPI_KEY=
X_RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Adzuna (Optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Maps / Places / Routes (Optional)
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
YOUTUBE_API_KEY=                         # optional; YouTube Data API v3, picks real videos for learning plans

# ── Authentication ────────────────────────────────────────────────────────────
# 32-byte random secret for signing JWT session tokens.  Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Firebase Phone Auth. Every page needs sign-in, so the app needs these and AUTH_SECRET.
#   1. Go to https://console.firebase.google.com → Add project
#   2. Project settings (gear icon) → General → Your apps → Add app → Web (</>)
#      Copy the firebaseConfig values below.
#   3. Authentication → Sign-in method → Phone → Enable
#   4. For the Admin SDK: Project settings → Service accounts → Generate new private key
#      Save the JSON file and copy the three values below.
#
# Client-side (NEXT_PUBLIC_ prefix makes them available in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=        # e.g. your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=         # e.g. your-project-id

# Server-side Admin SDK (never expose these to the browser)
FIREBASE_PROJECT_ID=                     # same as above
FIREBASE_CLIENT_EMAIL=                   # from the service account JSON
FIREBASE_PRIVATE_KEY=                    # from the service account JSON — include the -----BEGIN/END----- lines

# Google OAuth2 (create credentials at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorised redirect URI in your Google OAuth app:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/callback
# The site's public address, used for redirects after Google sign-in. Leave empty locally.
APP_BASE_URL=
# Shows the Google button. Set to on only after the redirect URI above is added in Google Cloud.
GOOGLE_SIGNIN=

# How long a login session lasts (seconds). Default: 2592000 (30 days)
# SESSION_TTL_SECONDS=2592000

# Where the SQLite database is kept. Defaults to .data/daari.db locally; required in production,
# and must be outside the release folder so deploys keep it.
# DATABASE_PATH=/home/ishan/daari/shared/daari.db

# Featured listings. ADMIN_SECRET guards POST /api/admin/featured (header x-admin-secret); the route is closed if unset.
# ADMIN_SECRET=
# Provider requests for featured placement are approved automatically; set to off to hold them for review.
# FEATURED_AUTO_APPROVE=on
